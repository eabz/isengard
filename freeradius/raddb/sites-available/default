# Outer server: what the access points talk to (RADIUS auth/acct on 1812/1813).
#
# Everything is EAP-TTLS. The TLS tunnel and inner PAP are handed to the
# inner-tunnel virtual server, which does the Google LDAP lookup + bind.

server default {

	listen {
		type = auth
		ipaddr = *
		port = 0
		limit {
			max_connections = 16
			lifetime = 0
			idle_timeout = 30
		}
	}

	listen {
		type = acct
		ipaddr = *
		port = 0
	}

	authorize {
		filter_username
		preprocess

		# Start / continue the EAP conversation.
		eap {
			ok = return
		}
	}

	authenticate {
		Auth-Type eap {
			eap
		}
	}

	preacct {
		preprocess
	}

	accounting {
		detail
	}

	session {
	}

	post-auth {
		# Long time between full reauthentications, with seamless in-place reauth.
		# 172800 = 2 days; keep the EAP TLS cache lifetime (mods-available/eap) at
		# least this long so the reauth resumes instead of doing a full handshake.
		update reply {
			&Session-Timeout := 172800
			&Termination-Action := RADIUS-Request

			# Interim-Update every 10 min (was left to the NAS default, 3600s).
			# Tighter interims bound how stale a Framed-IP-Address<->session
			# mapping can be, and let scripts/lookup_user.py detect a dead
			# session (2 missed interims = 20 min silence) instead of treating
			# a NAS-abandoned session as open indefinitely.
			&Acct-Interim-Interval := 600
		}

		Post-Auth-Type REJECT {
			eap
			attr_filter.access_reject
		}
	}
}
