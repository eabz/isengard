# Outer server: what the access points talk to (RADIUS auth/acct on 1812/1813).
#
# Everything is EAP-TTLS. The TLS tunnel and inner PAP are handed to the
# inner-tunnel virtual server, which does the Google LDAP lookup + bind.

server default {

	listen {
		type = auth
		ipaddr = *
		port = 0
		limit {
			max_connections = 16
			lifetime = 0
			idle_timeout = 30
		}
	}

	listen {
		type = acct
		ipaddr = *
		port = 0
	}

	authorize {
		filter_username
		preprocess

		# Start / continue the EAP conversation.
		eap {
			ok = return
		}
	}

	authenticate {
		Auth-Type eap {
			eap
		}
	}

	preacct {
		preprocess
	}

	accounting {
		detail
	}

	session {
	}

	post-auth {
		# Long time between full reauthentications, with seamless in-place reauth.
		# 172800 = 2 days; keep the EAP TLS cache lifetime (mods-available/eap) at
		# least this long so the reauth resumes instead of doing a full handshake.
		update reply {
			&Session-Timeout := 172800
			&Termination-Action := RADIUS-Request

			# Interim-Update every 10 min (was left to the NAS default, 3600s).
			# Tighter interims bound how stale a Framed-IP-Address<->session
			# mapping can be, and let scripts/lookup_user.py detect a dead
			# session (2 missed interims = 20 min silence) instead of treating
			# a NAS-abandoned session as open indefinitely.
			&Acct-Interim-Interval := 600
		}

		# The inner tunnel resolved a real identity: put it in the
		# Access-Accept so the AP reports THAT in accounting instead of the
		# "anonymous" outer identity it sent us. Purely additive -- if the
		# inner tunnel never ran (EAP TLS session resumption) session-state is
		# empty and the reply goes out untouched.
		#
		# Whether the AP honours it is vendor-specific. If the UDM still shows
		# "anonymous" after this is deployed, UniFi is ignoring the attribute
		# and attribution has to go through scripts/lookup_user.py instead.
		# Note this puts the real username in the RADIUS reply on the wire,
		# where the anonymous outer identity was deliberately hiding it --
		# fine on this LAN, but it is the tradeoff being made.
		if (&session-state:User-Name) {
			update reply {
				&User-Name := "%{session-state:User-Name}"
			}
		}

		Post-Auth-Type REJECT {
			eap
			attr_filter.access_reject
		}
	}
}
