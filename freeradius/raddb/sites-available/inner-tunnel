# Inner tunnel for EAP-TTLS against Google Secure LDAP.
#
# Handles both inner methods that carry a cleartext password: plain PAP and
# EAP-GTC. (MS-CHAPv2 cannot work — Google never exposes the password hash.)
# We normalize the username to a bare lowercase uid, look the user up in Google
# LDAP, then bind as that user (DN for cedros, email for colegios).

server inner-tunnel {

	listen {
		ipaddr = 127.0.0.1
		port = 18120
		type = auth
	}

	authorize {
		filter_username

		# Username only: accept "jpsanchez" or "jpsanchez@<anydomain>" and reduce
		# to the bare lowercase uid that Google LDAP indexes. Also remember the
		# realm the user typed (lowercased) so we can disambiguate collisions.
		if (&User-Name =~ /^([^@]+)@(.+)$/) {
			update request {
				&Stripped-User-Name := "%{tolower:%{1}}"
			}
			update control {
				&Tmp-String-0 := "%{tolower:%{2}}"
			}
		}
		else {
			update request {
				&Stripped-User-Name := "%{tolower:%{User-Name}}"
			}
			# No realm typed: default to the primary domain so the colegios
			# check below is always a clean string compare. Referencing an UNSET
			# &control:Tmp-String-0 in the if() throws "Failed retrieving values
			# required to evaluate condition" on every bare-username login.
			update control {
				&Tmp-String-0 := "cedrosnorte.edu.mx"
			}
		}

		# Find the user FIRST (before eap), so the bind identity is ready whether
		# the phone uses plain PAP or inner EAP-GTC.
		#   cedrosnorte : found by uid  -> bind as the DN
		#   colegios    : found by mail -> bind as the email (DN bind returns 49)
		#
		# Username collisions: the SAME username can be two DIFFERENT people
		# (uid=<user> in cedrosnorte vs mail=<user>@colegios-cedros-paseo.mx). A
		# colegios user who collides with a cedros uid MUST log in as
		# user@colegios-cedros-paseo.mx; we then skip the uid search and bind as
		# the email, so we never match the other (cedros) person. Bare usernames
		# and @cedrosnorte.edu.mx keep the uid-first behavior, and non-colliding
		# colegios users still work via the notfound fallback below.
		if (&control:Tmp-String-0 == "colegios-cedros-paseo.mx") {
			ldap_colegios
			if (ok || updated) {
				update control {
					&LDAP-UserDn := "%{tolower:%{Stripped-User-Name}}@colegios-cedros-paseo.mx"
				}
			}
		}
		else {
			ldap_google
			if (notfound) {
				ldap_colegios
				if (ok || updated) {
					update control {
						&LDAP-UserDn := "%{tolower:%{Stripped-User-Name}}@colegios-cedros-paseo.mx"
					}
				}
			}
		}

		# Inner EAP-GTC: drive the tunneled EAP exchange. Challenge rounds stop
		# here (handled); the final round leaves &User-Password set and the gtc
		# submodule sets Auth-Type := PAP.
		eap {
			ok = return
		}

		# Plain PAP, or GTC just delivered the password: do the LDAP bind.
		if (&User-Password && !&control:Auth-Type) {
			update control {
				&Auth-Type := LDAP
			}
		}
	}

	authenticate {
		# Both bind as &control:LDAP-UserDn (DN for cedros, email for colegios).
		Auth-Type LDAP {
			ldap_google
		}
		Auth-Type PAP {
			ldap_google
		}

		eap
	}

	session {
	}

	post-auth {
		# Record the real, fully-qualified identity against the MAC. This is the
		# only place the outer "anonymous" identity and the real LDAP identity
		# are ever seen together; see mods-available/linelog_inner.
		#
		# Both guards matter:
		#
		# 1. Statements at the top level of post-auth run for REJECTS TOO.
		#    FreeRADIUS enters post-auth with &control:Post-Auth-Type := Reject
		#    and still walks the whole section — "Post-Auth-Type REJECT" below is
		#    a switch on that attribute, NOT an early exit. Without the
		#    Access-Accept check, every failed password would write an identity
		#    line for that MAC, and lookup_user.py would attribute browsing to
		#    someone who only ever typed a username at the login prompt.
		#
		# 2. If authorize never set Stripped-User-Name (e.g. a bare probe with no
		#    identity), the format string would still emit a junk line ending in
		#    "\t@cedrosnorte.edu.mx". Short-circuit with && so an unset attribute
		#    is never dereferenced — the same trap the authorize section above
		#    documents for &control:Tmp-String-0.
		if (&reply:Packet-Type == Access-Accept) {
			# Calling-Station-Id is the ONLY join key downstream. It reaches
			# the tunnel via copy_request_to_tunnel = yes in mods-available/eap;
			# if that ever stops holding, the format string would still write a
			# well-formed line with an EMPTY mac field, which joins to nothing
			# and is indistinguishable from "device never authenticated". Refuse
			# to write the line at all rather than log something unusable.
			if (&Stripped-User-Name && &control:Tmp-String-0 && &Calling-Station-Id) {
				inner_identity_log
			}
		}

		Post-Auth-Type REJECT {
			attr_filter.access_reject
		}
	}
}
